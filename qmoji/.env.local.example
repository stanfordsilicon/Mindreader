# Frontend Environment Variables - Copy to .env.local for local development

# Backend API endpoint
# Local development (Flask on localhost:8000)
VITE_EMOJI_API_URL=http://localhost:8000/api/index

# For AWS deployed backend, use the API Gateway URL:
# VITE_EMOJI_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/dev/api/index
